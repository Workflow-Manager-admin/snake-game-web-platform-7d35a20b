---
/**
PUBLIC_INTERFACE
A modern, minimalistic, and responsive implementation of the Snake game.
Features:
 - Classic Snake gameplay
 - Score tracking
 - Pause/resume and restart
 - Keyboard and touch controls
 - Responsive, light theme, custom primary/secondary/accent colors
*/
const primary = "#4CAF50";
const secondary = "#222222";
const accent = "#FFC107";
---

<div class="snake-container">
  <header class="snake-header">
    <h2>Snake Game</h2>
    <div class="score-box">
      <span>Score: <b id="score">0</b></span>
    </div>
  </header>
  <div
    id="game-board"
    class="game-board"
    tabindex="0"
    aria-label="Snake Game Board"
    role="application"
  ></div>
  <div class="controls">
    <button id="pause-btn" aria-label="Pause" tabindex="0">Pause</button>
    <button id="resume-btn" aria-label="Resume" tabindex="0" style="display:none;">Resume</button>
    <button id="restart-btn" aria-label="Restart" tabindex="0">Restart</button>
  </div>
  <div class="touch-controls" id="touch-controls" style="display: none;">
    <!-- Touch arrows for mobile -->
    <button class="arrow up" data-dir="up" aria-label="Up"></button>
    <div>
      <button class="arrow left" data-dir="left" aria-label="Left"></button>
      <button class="arrow right" data-dir="right" aria-label="Right"></button>
    </div>
    <button class="arrow down" data-dir="down" aria-label="Down"></button>
  </div>
</div>

<style>
.snake-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  min-height: 80vh;
  padding: 2rem 0.5rem 1.5rem 0.5rem;
  background: var(--bg-color, #fff);
}
.snake-header {
  width: 100%;
  max-width: 360px;
  text-align: center;
  margin-bottom: 1.2rem;
}
.snake-header h2 {
  margin: 0;
  font-size: 1.7rem;
  font-weight: 600;
  color: #222222;
  letter-spacing: 1px;
}
.score-box {
  margin-top: 0.4rem;
  background: #4CAF5012;
  border-radius: 6px;
  padding: 0.3rem 1.4rem;
  color: #4CAF50;
  font-size: 1.1rem;
  font-weight: 600;
  display: inline-block;
  box-shadow: 0 0 0.5rem #0001;
}

.game-board {
  display: grid;
  grid-template-rows: repeat(20, 1fr);
  grid-template-columns: repeat(20, 1fr);
  gap: 2px;
  width: 360px;
  height: 360px;
  background: #f7faf7;
  border: 3px solid #4CAF50;
  border-radius: 12px;
  position: relative;
  outline: none;
  margin-bottom: 1.1rem;
  box-sizing: border-box;
  touch-action: none;
  box-shadow: 0 1px 16px #4CAF5022;
  transition: box-shadow 0.2s;
}
@media (max-width: 480px) {
  .game-board {
    width: 94vw;
    height: 94vw;
    max-width: 360px;
    max-height: 360px;
  }
  .snake-header {
    max-width: 94vw;
  }
}

.snake-cell {
  background: transparent;
  width: 100%;
  height: 100%;
  border-radius: 24%;
  transition: background 0.14s, box-shadow 0.13s;
}
.snake-segment {
  background: #4CAF50;
  box-shadow: 0 0 4px 1px #4CAF5044;
}
.snake-head {
  background: #FFC107;
  box-shadow: 0 0 8px 2px #FFC10744;
}
.food {
  background: #222222;
  box-shadow: 0 0 2px 2px #22222233;
}
.dead {
  background: #c62828 !important;
  box-shadow: 0 0 4px 2px #c6282822 !important;
}
.controls {
  display: flex;
  gap: 1.1rem;
  margin-bottom: 0.6rem;
}
.controls button {
  padding: 0.65em 1.6em;
  font-size: 1.05em;
  background: #4CAF50;
  color: #fff;
  border: none;
  border-radius: 8px;
  font-family: inherit;
  cursor: pointer;
  font-weight: 600;
  transition: background 0.2s;
  outline: none;
  box-shadow: 0 1px 8px #4CAF501a;
}
.controls button:active {
  filter: brightness(0.92);
}
.controls button[disabled] {
  background: #bdbdbd;
  color: #fff;
  cursor: not-allowed;
}

/* Touch controls styling */
.touch-controls {
  margin-top: 1.1rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.4rem;
}
.touch-controls .arrow {
  width: 3.2rem;
  height: 3.2rem;
  border: none;
  background: #4CAF50;
  color: #fff;
  border-radius: 10px;
  margin: 0.08rem;
  font-size: 1.7rem;
  box-shadow: 0 0 4px #4CAF5077;
  position: relative;
  cursor: pointer;
}
.touch-controls .arrow:active {
  background: #FFC107;
}
.touch-controls .arrow.up::after,
.touch-controls .arrow.down::after,
.touch-controls .arrow.left::after,
.touch-controls .arrow.right::after {
  content: '';
  position: absolute;
  display: block;
  width: 1.4rem;
  height: 1.4rem;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  background-repeat: no-repeat;
  background-position: center;
  background-size: 1.0rem 1.0rem;
}
.touch-controls .arrow.up::after {
  background-image: url('data:image/svg+xml;utf8,<svg fill="white" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"><polygon points="10,4 16,14 4,14"/></svg>');
}
.touch-controls .arrow.down::after {
  background-image: url('data:image/svg+xml;utf8,<svg fill="white" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"><polygon points="4,6 16,6 10,16"/></svg>');
}
.touch-controls .arrow.left::after {
  background-image: url('data:image/svg+xml;utf8,<svg fill="white" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"><polygon points="6,10 16,4 16,16"/></svg>');
}
.touch-controls .arrow.right::after {
  background-image: url('data:image/svg+xml;utf8,<svg fill="white" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"><polygon points="14,10 4,4 4,16"/></svg>');
}

/* Accessibility focus style */
.game-board:focus {
  box-shadow: 0 0 0 3px #FFC10799;
}
@media (max-width: 430px) {
  .snake-header, .game-board {
    max-width: 99vw;
  }
}
</style>

<script type="module">
// -- JS remains unchanged --
const ROWS = 20, COLS = 20, TICK = 90; // px
let snake, direction, nextDirection, food, score, alive, paused, timer;

const board = document.getElementById("game-board");
const scoreEl = document.getElementById("score");
const pauseBtn = document.getElementById("pause-btn");
const resumeBtn = document.getElementById("resume-btn");
const restartBtn = document.getElementById("restart-btn");
const touchControls = document.getElementById("touch-controls");

function isMobile() {
  return window.matchMedia("(pointer: coarse)").matches;
}
if (isMobile()) {
  touchControls.style.display = "flex";
}

// Utility
function posToIdx([r, c]) {
  return r * COLS + c;
}

function spawnFood(snakeArr) {
  let emptyCells = [];
  for (let i = 0; i < ROWS; ++i)
    for (let j = 0; j < COLS; ++j)
      if (!snakeArr.some(([sr, sc]) => sr === i && sc === j))
        emptyCells.push([i, j]);
  return emptyCells[Math.floor(Math.random() * emptyCells.length)];
}

function render() {
  board.innerHTML = "";
  for (let r = 0; r < ROWS; ++r) {
    for (let c = 0; c < COLS; ++c) {
      let cell = document.createElement("div");
      cell.className = "snake-cell";
      if (snake.some(([sr, sc]) => sr === r && sc === c)) {
        if (snake[0][0] === r && snake[0][1] === c)
          cell.classList.add("snake-head");
        else
          cell.classList.add("snake-segment");
      }
      if (food[0] === r && food[1] === c)
        cell.classList.add("food");
      if (!alive && snake.some(([sr, sc]) => sr === r && sc === c))
        cell.classList.add("dead");
      board.appendChild(cell);
    }
  }
  scoreEl.textContent = score;
}

function resetGame() {
  snake = [[10, 9], [10, 8], [10, 7]];
  direction = "right";
  nextDirection = "right";
  food = spawnFood(snake);
  score = 0;
  alive = true;
  paused = false;
  render();
  pauseBtn.style.display = "";
  resumeBtn.style.display = "none";
}

function gameStep() {
  if (paused || !alive) return;
  let d = {up:[-1,0], down:[1,0], left:[0,-1], right:[0,1]}[nextDirection];
  let [hr, hc] = snake[0];
  let newHead = [hr + d[0], hc + d[1]];
  if (
    newHead[0] < 0 || newHead[0] >= ROWS ||
    newHead[1] < 0 || newHead[1] >= COLS ||
    snake.some(([r, c]) => r === newHead[0] && c === newHead[1])
  ) {
    alive = false;
    render();
    pauseBtn.disabled = resumeBtn.disabled = true;
    setTimeout(() => {
      alert("Game over! Your score: " + score);
    }, 50);
    return;
  }
  snake.unshift(newHead);
  if (newHead[0] === food[0] && newHead[1] === food[1]) {
    score += 1;
    food = spawnFood(snake);
  } else {
    snake.pop();
  }
  direction = nextDirection;
  render();
}

function changeDirection(dir) {
  const opposites = {up:"down",down:"up",left:"right",right:"left"};
  if (!alive || paused) return;
  if (dir === direction || dir === opposites[direction]) return;
  nextDirection = dir;
}

function tick() {
  if (!paused && alive) gameStep();
  timer = setTimeout(tick, TICK);
}

pauseBtn.onclick = () => {
  paused = true;
  pauseBtn.style.display = "none";
  resumeBtn.style.display = "";
  board.tabIndex = -1;
};
resumeBtn.onclick = () => {
  paused = false;
  pauseBtn.style.display = "";
  resumeBtn.style.display = "none";
  board.tabIndex = 0;
};
restartBtn.onclick = () => {
  clearTimeout(timer);
  resetGame();
  tick();
};

board.addEventListener("keydown", (e) => {
  const dirs = {
    ArrowUp: "up", KeyW: "up",
    ArrowDown: "down", KeyS: "down",
    ArrowLeft: "left", KeyA: "left",
    ArrowRight: "right", KeyD: "right"
  };
  if (dirs[e.code]) {
    changeDirection(dirs[e.code]);
    e.preventDefault();
  }
  if (e.key === " " && alive) {
    paused = !paused;
    pauseBtn.style.display = paused ? "none" : "";
    resumeBtn.style.display = paused ? "" : "none";
  }
});
if (isMobile()) {
  // Touch control handlers
  let recentTouch = 0;
  // Touch swipe
  let touchStart = null;
  board.addEventListener('touchstart', e => {
    const t = e.touches[0];
    touchStart = { x: t.clientX, y: t.clientY };
  });
  board.addEventListener('touchend', e => {
    if (!touchStart) return;
    const t = e.changedTouches[0];
    const dx = t.clientX - touchStart.x, dy = t.clientY - touchStart.y;
    if (Math.abs(dx) < 20 && Math.abs(dy) < 20) return;
    if (Math.abs(dx) > Math.abs(dy)) {
      if (dx > 0) changeDirection("right");
      else changeDirection("left");
    } else {
      if (dy > 0) changeDirection("down");
      else changeDirection("up");
    }
    touchStart = null;
  });
  // Touch arrows
  touchControls.querySelectorAll('.arrow').forEach(btn => {
    btn.onclick = () => {
      changeDirection(btn.dataset.dir);
    }
  });
}

window.addEventListener("resize", () => {
  if (isMobile()) touchControls.style.display = "flex";
  else touchControls.style.display = "none";
});

// Start game
resetGame();
tick();
board.focus();
</script>
